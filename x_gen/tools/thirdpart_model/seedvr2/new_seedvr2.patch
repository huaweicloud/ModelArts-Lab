+def merge_video_with_border(
+        h_block,
+        w_block,
+        world_size: int,
+        tensor_list: List[torch.Tensor],
+        overlap_border: int = 32
+) -> torch.Tensor:
+    """
+    修正后的视频块合并函数，处理带缓存边界的视频块
+    输入张量形状为 (t, h, w, c)，列表索引对应进程rank
+
+    参数:
+        world_size: 总进程数（支持2,4,8）
+        tensor_list: 视频块列表，每个元素为一个进程的带缓存视频块
+        overlap_border: 缓存边界像素数（默认32）
+
+    返回:
+        合并后的完整视频，形状为 (t, full_h, full_w, c)
+    """
+    # 单进程直接返回
+    if world_size == 1:
+        return tensor_list[0]
+
+    # 输入验证
+    if not tensor_list:
+        raise ValueError("tensor_list不能为空")
+    if len(tensor_list) != world_size:
+        raise ValueError(f"tensor_list长度({len(tensor_list)})与world_size({world_size})不匹配")
+
+    # 获取基础信息（从第一个有效张量）
+    first_tensor = None
+    for tensor in tensor_list:
+        if tensor is not None:
+            first_tensor = tensor
+            break
+    if first_tensor is None:
+        raise ValueError("tensor_list中所有元素均为None")
+
+    if first_tensor.dim() != 4:
+        raise ValueError(f"输入张量必须是4维(t, h, w, c)，实际为{first_tensor.shape}")
+
+    # 解析形状 (t, h, w, c)
+    t, h, w, c = first_tensor.shape
+    device = first_tensor.device
+    dtype = first_tensor.dtype
+
+    # 验证所有张量的基本维度一致性
+    for rank in range(world_size):
+        tensor = tensor_list[rank]
+        if tensor is None:
+            raise ValueError(f"rank {rank} 的张量为None")
+        if tensor.device != device:
+            raise ValueError(f"rank {rank} 设备不匹配: {tensor.device} vs {device}")
+        if tensor.shape[0] != t or tensor.shape[3] != c:
+            raise ValueError(
+                f"rank {rank} 维度不匹配: 期望(t={t}, c={c})，实际{tensor.shape}"
+            )
+
+    # 确定切分方式
+    if world_size == 8:
+        long_div, short_div = 4, 2  # 长边4分，短边2分
+    elif world_size == 4:
+        long_div, short_div = 2, 2  # 长边2分，短边2分
+    elif world_size == 2:
+        long_div, short_div = 2, 1  # 长边2分，短边不切
+    else:
+        raise ValueError("world_size只支持2,4,8")
+
+    # 确定长边和短边（基于视频块的空间尺寸）
+    if w_block >= h_block:
+        is_landscape = True  # 宽为长边，高为短边
+        long_side = w  # w_block
+        short_side = h  # h_block
+    else:
+        is_landscape = False  # 高为长边，宽为短边
+        long_side = h  # h_block
+        short_side = w  # w_block
+
+    # 计算单块有效尺寸（减去两边缓存）
+    if world_size == 4:
+        effective_long = long_side - overlap_border
+        effective_short = short_side - overlap_border
+    elif world_size == 2:
+        effective_long = long_side - overlap_border
+        effective_short = short_side
+    elif world_size == 8:
+        effective_long = long_side - 2 * overlap_border
+        effective_short = short_side - overlap_border
+    else:
+        raise ValueError("world_size只支持2,4,8")
+
+    # 计算完整视频尺寸
+    if world_size == 8:
+        full_long = effective_long * long_div + 2 * overlap_border
+        full_short = effective_short * short_div
+    else:
+        full_long = effective_long * long_div
+        full_short = effective_short * short_div
+
+    # 映射到实际视频的高和宽
+    if is_landscape:
+        full_w, full_h = full_long, full_short
+    else:
+        full_h, full_w = full_long, full_short
+
+    # 初始化合并结果和计数矩阵
+    merged_video = torch.zeros(
+        (t, full_h, full_w, c),
+        device=device,
+        dtype=dtype
+    )
+    count_matrix = torch.zeros(
+        (full_h, full_w),
+        device=device,
+        dtype=torch.int32
+    )
+
+    # 处理每个视频块
+    for rank in range(world_size):
+        tensor = tensor_list[rank]
+        t_curr, h_curr, w_curr, c_curr = tensor.shape
+
+        # 计算当前块在网格中的位置
+        i = rank // short_div  # 长边方向索引
+        j = rank % short_div  # 短边方向索引
+
+        # 计算有效区域在完整视频中的坐标（不含缓存）
+        if is_landscape:
+            # 宽为长边，高为短边
+            if world_size == 8:
+                x_start = max(i * effective_long, 0)
+                x_end = min(x_start + effective_long + 2 * overlap_border, full_w)
+            else:
+                x_start = max(i * effective_long - overlap_border, 0)
+                x_end = min(x_start + effective_long + overlap_border, full_w)
+            if short_div > 1:
+                y_start = max(j * effective_short - overlap_border, 0)
+                y_end = min(y_start + effective_short + overlap_border, full_h)
+            else:
+                y_start = j * effective_short
+                y_end = y_start + effective_short
+
+
+        else:
+            if world_size == 8:
+                y_start = max(i * effective_long, 0)
+                y_end = min(y_start + effective_long + 2 * overlap_border, full_h)
+            else:
+                # 高为长边，宽为短边
+                y_start = max(i * effective_long - overlap_border, 0)
+                y_end = min(y_start + effective_long + overlap_border, full_h)
+            if short_div > 1:
+                x_start = max(j * effective_short - overlap_border, 0)
+                x_end = min(x_start + effective_short + overlap_border, full_w)
+            else:
+                x_start = j * effective_short
+                x_end = x_start + effective_short
+
+        merged_video[:, y_start:y_end, x_start:x_end, :] += tensor[:, :, :, :]
+        count_matrix[y_start:y_end, x_start:x_end] += 1
+
+    # 处理重叠区域：计算平均值
+    count_matrix = count_matrix.clamp(min=1)  # 避免除零
+    count_matrix = count_matrix.unsqueeze(0).unsqueeze(-1)  # 扩展为 (1, h, w, 1)
+    merged_video = merged_video / count_matrix.to(dtype)
+
+    if world_size == 8:
+        if is_landscape:
+            merged_video = merged_video[:, :, 32:full_long - 32, :]
+        else:
+            merged_video = merged_video[:, 32:full_long - 32, :, :]
+
+    return merged_video
+
+
+def save_frames_to_video(frames_tensor, output_path, fps=30.0, debug=False):
+    """
+    Save frames tensor to video file
+
+    Args:
+        frames_tensor (torch.Tensor): Frames in format [T, H, W, C] (Float16, 0-1)
+        output_path (str): Output video path
+        fps (float): Output video FPS
+        debug (bool): Enable debug logging
+    """
+    if debug:
+        print(f"🎬 Saving {frames_tensor.shape[0]} frames to video: {output_path}")
+
+    # Ensure output directory exists
+    # os.makedirs(os.path.dirname(output_path), exist_ok=True)
+
+    # Convert tensor to numpy and denormalize
+    frames_np = frames_tensor.detach().cpu().numpy()
+    frames_np = (frames_np * 255.0).astype(np.uint8)
+
+    # Get video properties
+    T, H, W, C = frames_np.shape
+
+    # Initialize video writer
+    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
+    out = cv2.VideoWriter(output_path, fourcc, fps, (W, H))
+
+    if not out.isOpened():
+        raise ValueError(f"Cannot create video writer for: {output_path}")
+
+    # Write frames
+    for i, frame in enumerate(frames_np):
+        # Convert RGB to BGR for OpenCV
+        frame_bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
+        out.write(frame_bgr)
+
+        if debug and (i + 1) % 100 == 0:
+            print(f"💾 Saved {i + 1}/{T} frames")
+
+    out.release()
+
+    if debug:
+        print(f"✅ Video saved successfully: {output_path}")
+
+
+def run_distributed_processing_tiling(runner, frames_np, args):
+    rank = dist.get_rank()
+    world_size = dist.get_world_size()
+    torch.cuda.set_device(rank)
+
+    device = f"npu:{rank}"
+
+    t, h, w, c = frames_np.shape
+
+    chunks = frames_np
+
+    local_chunk = torch.from_numpy(frames_np).to(torch.bfloat16).cuda(rank)  # Ensure local_chunk is on the correct GPU
+
+    generation_loop_tiling(
+        runner=runner,
+        images=local_chunk,
+        cfg_scale=1.0,
+        seed=args.seed,
+        res_w=args.resolution,
+        batch_size=t + 1,
+        preserve_vram=True,
+        temporal_overlap=0,
+        debug=False,
+        rank=rank,
+        world_size=world_size,
+        device=device,
+        frame_interpolation = args.frame_interpolation_sr,
+        frame_model_path = args.frame_model_path,
+        save_fps = args.save_fps,
+    )
+
+
+class SeedVR2_Pipe():
+    def __init__(self, args):
+        self.args = args
+        self.runner = configure_runner(
+            args.seedvr2_model_name,
+            args.seedvr2_model_dir,
+            True,
+            False,
+        )
+        device=f"npu:{dist.get_rank()}"
+        self.runner.dit.to("cpu",dtype=torch.float16)
+        self.runner.vae.to(device,dtype=torch.float16)
+
+        for name, module in self.runner.dit.named_children():
+            if name != "blocks":
+                module.to("npu")
+
+        
+        inf_vram_blocks_num = 1
+        offloader = OffloadManager(
+            self.runner.dit,
+            module_groups={"blocks": self.runner.dit.blocks},
+            keep_n={"blocks": int(inf_vram_blocks_num)},
+            device=device,
+            dist_group=dist.group.WORLD,
+            sync_at_layer=True if dist.is_initialized() else False,
+        )
+        offloader.enable()
+
+    def __call__(self, images):
+        start_time = time.time()
+        with torch.no_grad():
+            run_distributed_processing_tiling(self.runner, images, self.args)
